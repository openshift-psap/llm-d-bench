{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "description": "Namespace to deploy resources"
    },
    "deploy": {
      "type": "boolean",
      "description": "Enable model deployment"
    },
    "decodeReplicas": {
      "type": "integer",
      "description": "Number of decode replica pods"
    },
    "prefillReplicas": {
      "type": "integer",
      "description": "Number of prefill replica pods"
    },
    "benchmarkTool": {
      "type": "string",
      "description": "Benchmark tool to use"
    },
    "benchmark": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Job name"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Full image repository URL. If empty, will be constructed from namespace"
            },
            "name": {
              "type": "string",
              "description": "Image name (used when repository is empty)"
            },
            "tag": {
              "type": "string",
              "description": "Image tag"
            },
            "pullPolicy": {
              "type": "string",
              "description": "Image pull policy",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "env": {
          "type": "object"
        },
        "target": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "processor": {
          "type": "string"
        },
        "backendType": {
          "type": "string"
        },
        "rateType": {
          "type": "string"
        },
        "rate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          ]
        },
        "data": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "maxSeconds": {
          "type": "string"
        },
        "accelerator": {
          "type": "string",
          "description": "Accelerator type (e.g., nvidia-h100, nvidia-a100)"
        },
        "tp": {
          "type": "integer",
          "description": "Tensor parallelism degree"
        },
        "gpus": {
          "type": "integer",
          "description": "Number of GPUs to request for the benchmark job",
          "minimum": 0
        },
        "vllmArgs": {
          "type": "array",
          "description": "Additional vLLM arguments for serving runtime",
          "items": {
            "type": "string"
          }
        },
        "additionalArgs": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "description": "Tags to upload to MLflow as key-value pairs",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "logPodMatchingLabel": {
      "type": "string"
    },
    "kueue": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "queueName": {
          "type": "string"
        }
      }
    },
    "mlflow": {
      "type": "object",
      "description": "MLflow experiment tracking configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable MLflow experiment tracking"
        },
        "trackingUri": {
          "type": "string",
          "description": "MLflow tracking server URL"
        },
        "auth": {
          "type": "object",
          "description": "MLflow authentication configuration",
          "properties": {
            "secretName": {
              "type": "string",
              "description": "Secret name containing MLflow credentials"
            },
            "usernameKey": {
              "type": "string",
              "description": "Key in the secret for username"
            },
            "passwordKey": {
              "type": "string",
              "description": "Key in the secret for password"
            }
          },
          "required": ["secretName", "usernameKey", "passwordKey"]
        },
        "s3": {
          "type": "object",
          "description": "MLflow S3 credentials from a secret",
          "properties": {
            "secretName": {
              "type": "string",
              "description": "Secret name containing S3 credentials"
            },
            "accessKey": {
              "type": "string",
              "description": "Key in the secret for AWS_ACCESS_KEY_ID"
            },
            "secretKey": {
              "type": "string",
              "description": "Key in the secret for AWS_SECRET_ACCESS_KEY"
            },
            "bucketNameKey": {
              "type": "string",
              "description": "Key in the secret for S3 bucket name (used to construct MLFLOW_ARTIFACTS_DESTINATION)"
            },
            "regionKey": {
              "type": "string",
              "description": "Key in the secret for AWS region"
            }
          }
        }
      },
      "required": ["enabled"]
    }
  }
}
