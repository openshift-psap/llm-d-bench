repositories:
  - name: llm-d-modelservice
    url: https://llm-d-incubation.github.io/llm-d-modelservice/
  - name: llm-d-infra
    url: https://llm-d-incubation.github.io/llm-d-infra/

environments:
  # Quick start - Qwen 0.6B (1 GPU)
  qwen-0.6b:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
          uri: "hf://Qwen/Qwen3-0.6B"
          size: "20Gi"
        decode:
          replicas: 1
          tensorParallel: 1
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

  # Llama 3.3 70B Instruct FP8 dynamic (4 GPUs)
  llama-3.3b-70b-instruct-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          uri: "hf://RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          size: "50Gi"
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=4"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
        decode:
          replicas: 1
          tensorParallel: 4
        prefill:
          replicas: 0
          tensorParallel: 4
        gateway:
          className: istio

  # Llama 4 Maverick 17B 128E Instruct FP8 (8 GPUs)
  llama-4-maverick-17b-128e-instruct-fp8:
    values:
      - model:
          name: "RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          uri: "hf://RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          size: "60Gi"
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=8"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
            - "--kv-cache-dtype=fp8"
        decode:
          replicas: 1
          tensorParallel: 8
        prefill:
          replicas: 0
          tensorParallel: 8
        gateway:
          className: istio

  # Qwen3 235B A22B FP8 dynamic (4 GPUs)
  qwen3-235b-a22b-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          uri: "hf://RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          size: "120Gi"
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=4"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
            - "--enable-expert-parallel"
        decode:
          replicas: 1
          tensorParallel: 4
        prefill:
          replicas: 0
          tensorParallel: 4
        gateway:
          className: istio

  # gpt oss 120b (1 GPUs)
  gpt-oss-120b:
    values:
      - model:
          name: "openai/gpt-oss-120b"
          uri: "hf://openai/gpt-oss-120b"
          size: "80Gi"
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=1"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
        decode:
          replicas: 1
          tensorParallel: 1
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

  # Default
  default:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
        decode:
          replicas: 2
          tensorParallel: 1
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

---

releases:
  # Infrastructure (Gateway)
  - name: infra
    chart: llm-d/llm-d-infra
    version: v0.3.0
    namespace: {{ .Namespace }}
    values:
      - modelArtifacts:
          authSecretName: "llm-d-hf-token"
        modelStorage:
          pvc:
            create: true
            name: "{{ .Values.model.name | replace "/" "-" }}-pvc"
            size: {{ .Values.model.size }}

  # InferencePool (EPP/Scheduler)
  - name: gaie
    chart: llm-d/llm-d-gaie
    version: v0.3.2
    namespace: {{ .Namespace }}
    needs:
      - infra
    values:
      - "{{ if gt (.Values.prefill.replicas | int) 0 }}./configs/gaie/pd.yaml{{ else }}./configs/gaie/default.yaml{{ end }}"
      - gateway:
          className: {{ .Values.gateway.className }}

  # Decode LLMInferenceService
  - name: ms-decode
    chart: ./llm-inferenceservice
    namespace: {{ .Namespace }}
    needs:
      - gaie
    values:
      - role: "decode"
      - replicas: {{ .Values.decode.replicas }}
      - model:
          name: "{{ .Values.model.name }}"
          uri: "{{ .Values.model.uri }}"
          tensorParallel: {{ .Values.decode.tensorParallel }}
          size: {{ .Values.model.size }}
          # extraArgs:
          #   - "--your-arg"
          #   - "value"
          # extraEnv:
          #   - name: YOUR_ENV_VAR
          #     value: "value"

  # Prefill LLMInferenceService
  {{- if gt (.Values.prefill.replicas | int) 0 }}
  - name: ms-prefill
    chart: ./llm-inferenceservice
    namespace: {{ .Namespace }}
    needs:
      - gaie
    values:
      - role: "prefill"
      - replicas: {{ .Values.prefill.replicas }}
      - model:
          name: "{{ .Values.model.name }}"
          uri: "{{ .Values.model.uri }}"
          tensorParallel: {{ .Values.prefill.tensorParallel }}
          size: {{ .Values.model.size }}
          # extraArgs:
          #   - "--your-arg"
          #   - "value"
          # extraEnv:
          #   - name: YOUR_ENV_VAR
          #     value: "value"
  {{- end }}
