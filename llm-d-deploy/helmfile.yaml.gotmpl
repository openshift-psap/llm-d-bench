repositories:
  - name: llm-d-modelservice
    url: https://llm-d-incubation.github.io/llm-d-modelservice/
  - name: llm-d-infra
    url: https://llm-d-incubation.github.io/llm-d-infra/

environments:
  # Quick start - Qwen 0.6B (1 GPU)
  qwen-0.6b:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
          uri: "hf://Qwen/Qwen3-0.6B"
          size: "20Gi"
          tensorParallel: 1
        decode:
          replicas: 1
        gateway:
          className: istio

  # Llama 3.3 70B Instruct FP8 dynamic (4 GPUs)
  llama-3.3b-70b-instruct-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          uri: "hf://RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          size: "50Gi"
          tensorParallel: 4
        decode:
          replicas: 1
        gateway:
          className: istio
  
  # Llama 4 Maverick 17B 128E Instruct FP8 (8 GPUs)
  llama-4-maverick-17b-128e-instruct-fp8:
    values:
      - model:
          name: "RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          uri: "hf://RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          size: "60Gi"
          tensorParallel: 8
        decode:
          replicas: 1
        gateway:
          className: istio

  # Qwen3 235B A22B FP8 dynamic (4 GPUs)
  qwen3-235b-a22b-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          uri: "hf://RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          size: "120Gi"
          tensorParallel: 4
        decode:
          replicas: 1
        gateway:
          className: istio

  # gpt oss 120b (1 GPUs)
  gpt-oss-120b:
    values:
      - model:
          name: "openai/gpt-oss-120b"
          uri: "hf://openai/gpt-oss-120b"
          size: "80Gi"
          tensorParallel: 1
        decode:
          replicas: 1
        gateway:
          className: istio

  # Default
  default:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
          tensorParallel: 1
        decode:
          replicas: 2
        gateway:
          className: istio

---

{{- $gatewayClassName := .Values | get "gateway.className" "istio" -}}
{{- $modelName := .Values | get "model.name" "Qwen/Qwen3-0.6B" -}}
{{- $modelUri := .Values | get "model.uri" (printf "hf://%s" $modelName) -}}
{{- $modelSize := .Values | get "model.size" "20Gi" -}}
{{- $tensorParallel := .Values | get "model.tensorParallel" 1 -}}
{{- $decodeReplicas := .Values | get "decode.replicas" 2 -}}
{{- $prefillReplicas := .Values | get "prefill.replicas" 0 -}}
{{- $prefillEnabled := gt ($prefillReplicas | int) 0 -}}
{{- $gpuPerPod := $tensorParallel -}}

releases:
  # Infrastructure (Gateway)
  - name: infra
    namespace: {{ .Namespace | default "llm-d" }}
    chart: llm-d-infra/llm-d-infra
    version: v1.3.3
    installed: true
    values:
      - gateway:
          gatewayClassName: {{ $gatewayClassName }}

  # InferencePool (EPP/Scheduler)
  - name: gaie
    namespace: {{ .Namespace | default "llm-d" }}
    chart: oci://registry.k8s.io/gateway-api-inference-extension/charts/inferencepool
    version: v1.0.1
    installed: true
    needs:
      - infra
    values:
      - configs/gaie/{{ if $prefillEnabled }}pd{{ else }}default{{ end }}.yaml

  # Model Service
  - name: ms
    namespace: {{ .Namespace | default "llm-d" }}
    chart: llm-d-modelservice/llm-d-modelservice
    version: v0.2.10
    installed: true
    needs:
      - infra
      - gaie
    values:
      - configs/modelservice/base.yaml
    set:
      # Model configuration
      - name: modelArtifacts.name
        value: {{ $modelName | quote }}
      - name: modelArtifacts.uri
        value: {{ $modelUri | quote }}
      - name: modelArtifacts.size
        value: {{ $modelSize | quote }}
      # Decode configuration
      - name: decode.replicas
        value: {{ $decodeReplicas }}
      - name: decode.parallelism.tensor
        value: {{ $tensorParallel }}
      - name: decode.containers[0].resources.limits.nvidia\.com/gpu
        value: {{ $gpuPerPod }}
      - name: decode.containers[0].resources.requests.nvidia\.com/gpu
        value: {{ $gpuPerPod }}
      # Prefill configuration
      - name: prefill.create
        value: {{ $prefillEnabled }}
      {{- if $prefillEnabled }}
      - name: prefill.replicas
        value: {{ $prefillReplicas }}
      {{- end }}
      # Routing
      - name: routing.inferencePool.name
        value: gaie-ip
      - name: routing.parentRefs[0].name
        value: infra-inference-gateway
    setString:
      - name: decode.containers[0].env[0].value
        value: {{ if eq $gpuPerPod 1 }}0{{ else }}{{ join "," (until $gpuPerPod | toStrings) }}{{ end }}
