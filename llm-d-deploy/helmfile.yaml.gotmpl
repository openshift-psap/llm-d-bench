repositories:
  - name: llm-d-infra
    url: https://llm-d-incubation.github.io/llm-d-infra/

environments:
  # Quick start - Qwen 0.6B (1 GPU)
  qwen-0.6b:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
          uri: "hf://Qwen/Qwen3-0.6B"
          size: "20Gi"
        decode:
          extraArgs:
            - "--max-model-len=8192"
          replicas: 1
          tensorParallel: 1
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

  # Llama 3.3 70B Instruct FP8 dynamic (4 GPUs)
  llama-3.3b-70b-instruct-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          uri: "hf://RedHatAI/Llama-3.3-70B-Instruct-FP8-dynamic"
          size: "50Gi"
        decode:
          replicas: 1
          tensorParallel: 4
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=4"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
        prefill:
          replicas: 0
          tensorParallel: 4
        gateway:
          className: istio

  # Llama 4 Maverick 17B 128E Instruct FP8 (8 GPUs)
  llama-4-maverick-17b-128e-instruct-fp8:
    values:
      - model:
          name: "RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          uri: "hf://RedHatAI/Llama-4-Maverick-17B-128E-Instruct-FP8"
          size: "60Gi"
        decode:
          replicas: 1
          tensorParallel: 8
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=8"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
            - "--kv-cache-dtype=fp8"
        prefill:
          replicas: 0
          tensorParallel: 8
        gateway:
          className: istio

  # Qwen3 235B A22B FP8 dynamic (4 GPUs)
  qwen3-235b-a22b-fp8-dynamic:
    values:
      - model:
          name: "RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          uri: "hf://RedHatAI/Qwen3-235B-A22B-FP8-dynamic"
          size: "120Gi"
        decode:
          replicas: 1
          tensorParallel: 4
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=4"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
            - "--enable-expert-parallel"
        prefill:
          replicas: 0
          tensorParallel: 4
        gateway:
          className: istio

  # gpt oss 120b (1 GPUs)
  gpt-oss-120b:
    values:
      - model:
          name: "openai/gpt-oss-120b"
          uri: "hf://openai/gpt-oss-120b"
          size: "80Gi"
        decode:
          replicas: 1
          tensorParallel: 1
          extraArgs:
            - "--max-model-len=8192"
            - "--uvicorn-log-level=debug"
            - "--trust-remote-code"
            - "--tensor-parallel-size=1"
            - "--gpu-memory-utilization=0.92"
            - "--no-enable-prefix-caching"
            - "--disable-log-requests"
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

  # Default
  default:
    values:
      - model:
          name: "Qwen/Qwen3-0.6B"
          uri: "hf://Qwen/Qwen3-0.6B"
          size: "20Gi"
        decode:
          replicas: 2
          tensorParallel: 1
        prefill:
          replicas: 0
          tensorParallel: 1
        gateway:
          className: istio

---

releases:
  # Infrastructure (Gateway)
  - name: infra
    chart: llm-d-infra/llm-d-infra
    version: v1.3.3
    namespace: {{ .Namespace }}
    values:
      - gateway:
          gatewayClassName: {{ .Values.gateway.className }}

  # InferencePool (EPP/Scheduler)
  - name: gaie
    chart: oci://registry.k8s.io/gateway-api-inference-extension/charts/inferencepool
    version: v1.0.1
    namespace: {{ .Namespace }}
    needs:
      - infra
    values:
      - "{{ if gt (.Values.prefill.replicas | int) 0 }}./configs/gaie/pd.yaml{{ else }}./configs/gaie/default.yaml{{ end }}"
      - gateway:
          className: {{ .Values.gateway.className }}

  # LLMInferenceService for Decode
  - name: llm-service-decode
    chart: ./llm-inferenceservice
    namespace: {{ .Namespace }}
    needs:
      - gaie
    values:
      - role: "decode"
      - model:
          name: "{{ .Values.model.name }}"
          uri: "{{ .Values.model.uri }}"
          size: {{ .Values.model.size }}
      - decode: {{ .Values.decode | toYaml | nindent 10 }}
      - prefill: {{ .Values.prefill | toYaml | nindent 10 }}
      - gateway:
          className: {{ .Values.gateway.className }}

  {{- if gt (.Values.prefill.replicas | int) 0 }}
  # LLMInferenceService for Prefill
  - name: llm-service-prefill
    chart: ./llm-inferenceservice
    namespace: {{ .Namespace }}
    needs:
      - gaie
    values:
      - role: "prefill"
      - model:
          name: "{{ .Values.model.name }}"
          uri: "{{ .Values.model.uri }}"
          size: {{ .Values.model.size }}
      - decode: {{ .Values.decode | toYaml | nindent 10 }}
      - prefill: {{ .Values.prefill | toYaml | nindent 10 }}
      - gateway:
          className: {{ .Values.gateway.className }}
  {{- end }}