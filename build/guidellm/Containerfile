ARG IMAGE_VERSION=v0.5.2
FROM ghcr.io/vllm-project/guidellm:${IMAGE_VERSION}

# XXX: Temporary fix to keep track of the GuideLLM version
ENV GUIDELLM_VERSION=multiturn(e6c7e55)

USER root

RUN mkdir -p /tmp/.huggingface && chmod -R 777 /tmp/.huggingface

RUN dnf install git -y && git clone --branch feat/adv_prefix --single-branch https://github.com/vllm-project/guidellm.git /tmp/guidellm && cd /tmp/guidellm && pip install -e .

COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-warn-script-location .

ENTRYPOINT ["python3", "-m", "benchmark.main"]

CMD ["--help"]
