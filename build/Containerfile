ARG IMAGE_VERSION=v0.3.1
FROM ghcr.io/vllm-project/guidellm:${IMAGE_VERSION}

# XXX: Temporary fix to keep track of the GuideLLM version
ENV GUIDELLM_VERSION=v0.3.1

USER root

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-warn-script-location -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

RUN mkdir -p /tmp/.huggingface && chmod -R 777 /tmp/.huggingface

# Copy entire src directory structure
COPY src/ /usr/local/lib/python3.11/site-packages/

ENTRYPOINT ["python3", "-m", "run_benchmark"]

CMD ["--help"]
